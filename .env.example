# Copy to .env and fill in. Never commit .env.
# Get keys at https://app.alpaca.markets  (Paper Trading -> API Keys)
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here

# true = paper account (default). Set to false ONLY when you intend to trade real money,
# and you must also pass --live-money on the command line.
ALPACA_PAPER=true
